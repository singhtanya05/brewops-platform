          }
        ]
      },
      "item": [
        {
          "name": "Get Queue (PAID + PREPARING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/kitchen/orders?status=PAID,PREPARING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "kitchen",
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PAID,PREPARING"
                }
              ]
            }
          }
        },
        {
          "name": "Update Status - PREPARING",
          "request": {
