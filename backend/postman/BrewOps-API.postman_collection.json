                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"READY\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/kitchen/orders/{{orderId}}/status"
          }
