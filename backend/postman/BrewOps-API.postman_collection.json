              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PREPARING\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/kitchen/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Update Status - READY",
          "request": {
            "method": "PATCH",
            "header": [
